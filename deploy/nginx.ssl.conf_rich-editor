# «Редактор rich-контента Ozon»: https://tea-master-team.ru/management/rich-editor/
# Файл кладётся в /home/ivanc1539/conf/web/tea-master-team.ru/nginx.ssl.conf_rich-editor
# ^~ с более длинным адресом выигрывает у общего /management/ («Менеджмент») независимо от порядка файлов.
# После изменения: nginx -t && systemctl reload nginx

location = /management/rich-editor {
    return 301 /management/rich-editor/;
}

location ^~ /management/rich-editor/ {
    # Слэш в конце proxy_pass убирает префикс — приложение работает от корня
    proxy_pass http://127.0.0.1:3410/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    client_max_body_size 3m;
    add_header X-Robots-Tag "noindex, nofollow" always;
}
