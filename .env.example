# Настройки редактора rich-контента. Скопировать в .env и заполнить.
# .env в git не попадает.

# Порт службы (3100 — Менеджмент, 3200 — финансовая аналитика, 3300 — воронка WB).
PORT=3400
HOST=127.0.0.1

# Случайная строка не короче 32 символов. Создать: openssl rand -hex 32
SESSION_SECRET=

# Та же база, что у сайта (строка из backend/.env сайта).
DATABASE_URL=

# Запрос, который проверяет токен из «Менеджмента». Должен вернуть строку, если токен действует.
# :'t' — сам токен, :'th' — его SHA-256 (если в базе хранится хэш).
# ВАЖНО: взять тот же запрос, что у «Воронки продаж WB» (/home/ivanc1539/wb-salles-funnel),
# названия колонок ниже — пример.
AUTH_SQL=SELECT 1 FROM management_access_tokens WHERE token = :'t' AND expires_at > now() LIMIT 1

# Сколько минут действует вход по ссылке.
SESSION_TTL_MIN=60

# Путь, под которым редактор открыт на сайте (для cookie входа).
COOKIE_PATH=/management/rich-editor/

# Папка для общих шаблонов и их резервных копий.
DATA_DIR=data

# Только для проверки на своём компьютере: вход без ссылки. На сервере не включать.
# AUTH_DISABLED=1
